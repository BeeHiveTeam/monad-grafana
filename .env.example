# Grafana admin password.
# Generate: openssl rand -base64 24 | tr -d '/+=' | head -c 32
GF_SECURITY_ADMIN_PASSWORD=changeme-please-generate-strong-password

# Node metrics endpoint used to derive the monad_ch_* consensus-health signals.
# Defaults to the node on the same host; change it for a split deployment.
CH_ENDPOINT=http://host.docker.internal:9143/metrics
